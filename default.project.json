{
    "name": "rbxcad-dev",
	"emitLegacyScripts": false,
    "globIgnorePaths": [
        "**/package.json",
        "**/tsconfig.json",
		"out/examples"
    ],
	"tree": {
		"$className": "DataModel",
		"Workspace": {
		  "$path": "workspace.rbxmx"
		},
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					},
					"@rbxts-js": {
						"$path": "node_modules/@rbxts-js"
					}
				}
			},
			"rbxcad": {
				"$path": "out"
			}
		},
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"$properties": {
                "LoadStringEnabled": true
            }
		},
		"HttpService": {
            "$className": "HttpService",
            "$properties": {
                "HttpEnabled": true
            }
        }
	}
}